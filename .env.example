# Copy to .env for local dev. On Vercel, set these in Project Settings -> Environment Variables.
DATABASE_URL="postgresql://..."          # Neon connection string (pooled)
AUTH_SECRET=""                           # openssl rand -hex 32
APP_URL="https://your-app.vercel.app"    # used in magic links and SMS
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_FROM_NUMBER="+1314xxxxxxx"        # A2P 10DLC-registered number
RESEND_API_KEY=""
EMAIL_FROM="All American Inline Hockey <noreply@allamericaninlinehockey.com>"
CRON_SECRET=""                           # protects /api/cron/* ; Vercel sends it automatically
